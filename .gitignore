# Build output. It holds code translated from the disc (generated/), so it must never be published.
build/
__pycache__/

# Anything from the user's own copy of the game, and local runs.
game_files/
*.bin
*.iso
*.cue
*.img
*.mdf
*.sbi
*.mcr
*.mcd
*.srm
*.wav
*.exe
*.dll
*.pdb
*.lib
dojo.ini
state_*.bin

# The launcher's own settings, the game's saves and logs.
launcher.json
saves/
*.log

# The bundled toolchain (tools/fetch_toolchain.py), the downloaded decompilation, and release packaging.
toolchain/
decomp/
decomp.new/
dist/

# The launcher's self-update (launcher.pyw).
update.new/
update.failed
update.zip.part
